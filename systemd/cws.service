[Unit]
Description=My Node.js Application
After=network.target

[Service]
Type=simple
User=debottam
WorkingDirectory=/home/debottam/my-node-app
ExecStart=/usr/bin/node /home/debottam/my-node-app/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000

[Install]
WantedBy=multi-user.target
